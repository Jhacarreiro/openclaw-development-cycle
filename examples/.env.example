# Portable command adapter (required for implementation runs)
DEVELOPMENT_CYCLE_IMPLEMENTATION_ADAPTER=command
DEVELOPMENT_CYCLE_IMPLEMENTATION_COMMAND=$HOME/src/my-runner/implement
# DEVELOPMENT_CYCLE_IMPLEMENTATION_ARGS_JSON=["--format","json"]

# Optional Octopus adapter
# DEVELOPMENT_CYCLE_IMPLEMENTATION_ADAPTER=octopus
# DEVELOPMENT_CYCLE_OCTOPUS_ROOT=$HOME/src/claude-octopus
# DEVELOPMENT_CYCLE_OCTOPUS_SANDBOX=workspace-write

# Optional state and project documentation paths
# DEVELOPMENT_CYCLE_STATE_ROOT=$HOME/.openclaw/development-cycle
# DEVELOPMENT_CYCLE_PROJECT_DOCS_ROOT=$HOME/.openclaw/development-cycle/projects
# DEVELOPMENT_CYCLE_PROJECT_DOCS_GIT_ROOT=$HOME/src/project-docs

# Optional OpenClaw notifications
DEVELOPMENT_CYCLE_NOTIFICATIONS_ENABLED=false
# DEVELOPMENT_CYCLE_NOTIFICATION_CHANNEL=slack
# DEVELOPMENT_CYCLE_NOTIFICATION_TARGET=channel:C0123456789
# DEVELOPMENT_CYCLE_NOTIFICATION_ACCOUNT=default

# Optional external observer
DEVELOPMENT_CYCLE_OBSERVER_ENABLED=false
# DEVELOPMENT_CYCLE_OBSERVER_ADAPTER_ROOT=$HOME/src/observer-adapter

# Optional external planning/validation gate
# DEVELOPMENT_CYCLE_EXTERNAL_GATE_URL=https://validation.example.invalid
# DEVELOPMENT_CYCLE_EXTERNAL_GATE_SECRET_PATH=$HOME/.config/development-cycle/gate.env
