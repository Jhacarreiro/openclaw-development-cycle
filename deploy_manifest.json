{
  "$schema": "https://github.com/Jhacarreiro/openclaw-development-cycle/schemas/deploy-manifest-v1.schema.json",
  "schemaVersion": 1,
  "track": "deploy",
  "sourceCommit": "0000000000000000000000000000000000000000",
  "expectedMutations": [
    "build candidate artifacts outside production",
    "record current image identifiers for rollback"
  ],
  "protectedPaths": [
    "production configuration",
    "persistent service state"
  ],
  "requiredAuthorizations": [],
  "verificationChecks": [
    "health check",
    "release matches sourceCommit",
    "application smoke check"
  ],
  "rollback": {
    "available": true,
    "description": "Restore previous image identifiers recorded before promotion; no automatic rollback is performed.",
    "artifacts": []
  }
}
